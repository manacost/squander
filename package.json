{
  "name": "squander",
  "version": "8.0.0",
  "private": false,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run package",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package && node verification/run-publint.mjs",
    "prepublishOnly": "npm run package",
    "test": "npm run test:integration && npm run test:unit",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "npm run lint:format && npm run lint:code",
    "format": "prettier --write .",
    "test:integration": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:benchmark:ecs": "node verification/run-ecs-benchmark.mjs node",
    "test:benchmark:ecs:browser": "playwright test --config=playwright.ecs.config.ts",
    "test:benchmark:ecs:guard": "node verification/run-ecs-benchmark.mjs node --guard",
    "test:benchmark:ecs:browser:guard": "node verification/run-ecs-benchmark.mjs browser --guard",
    "lint:format": "prettier --check .",
    "lint:code": "eslint . --max-warnings 0",
    "test:type": "tsc --noEmit -p tsconfig.type-tests.json",
    "test:webgpu": "playwright test --config=playwright.webgpu.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:runtime": "vitest run --coverage --coverage.include='src/lib/core/runtime/**/*.ts' --coverage.exclude='src/lib/core/runtime/**/*.test.ts'",
    "check:coverage": "node verification/assert-coverage.mjs",
    "validate:specs": "node verification/validate-specs.mjs",
    "validate:package": "node verification/validate-package-exports.mjs",
    "validate:consumer": "node verification/validate-isolated-consumer.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./core/runtime": {
      "types": "./dist/core/runtime/index.d.ts",
      "default": "./dist/core/runtime/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./svelte/adapter": {
      "types": "./dist/svelte/adapter.d.ts",
      "default": "./dist/svelte/adapter.js"
    },
    "./*": "./dist/*"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "dependencies": {
    "prismjs": "^1.30.0"
  },
  "peerDependencies": {
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@webgpu/types": "^0.1.74",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "mdsvex": "^0.12.8",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "publint": "^0.3.25",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ancient-cat/squander.git"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
