<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="jumping-rope"
        Arguments=""
        InstallLocation="C:\Program Files\Squander\Jump Rope">
    </Installer>
    <PackageInformation
        PackageName="Jump Rope"
        PackageDisplayName="Jump Rope"
        PublisherName="CN=Squander"
        PublisherDisplayName="Squander"
        Version="0.1.0.0"
        PackageDescription="A Squander jumping-rope game">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.squander.jumpingrope"
                Description="A Squander jumping-rope game"
                DisplayName="Jump Rope"
                ExecutableName="jumping-rope"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Jump Rope</DisplayName>
            <PublisherDisplayName>Squander</PublisherDisplayName>
            <Description>A Squander jumping-rope game</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="jumping-rope.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
